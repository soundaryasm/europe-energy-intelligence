# Example dbt profile for this project (Spec 004).
#
# This file is safe to commit — it contains no secrets, only env_var()
# references. The real profiles.yml (gitignored) is expected to live in
# the Databricks Lakeflow Jobs `dbt` task's working directory or
# $DBT_PROFILES_DIR, populated from Databricks-managed secrets/job
# parameters at run time. Do not create a local copy for local execution
# — dbt for this project only runs on Databricks (Spec 004 "Execution
# Environment").
#
# Copy this file to `profiles.yml` in the location dbt expects and
# populate the env vars via the Databricks job/secret configuration.

europe_energy_intelligence:
  target: prod
  outputs:
    prod:
      type: databricks
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG') }}"
      schema: "{{ env_var('DBT_DATABRICKS_SCHEMA', 'gold') }}"
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
